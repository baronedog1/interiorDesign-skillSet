{
  "schema": "interior.model-backend-options.v1",
  "backend": "html-threejs",
  "ceilings": {
    "enabled": true,
    "visibleByDefault": false,
    "thicknessMeters": 0.08
  },
  "windows": {
    "defaultStyle": "frameless-glass",
    "allowedStyles": ["frameless-glass", "fixed-pane", "casement", "sliding"],
    "overrides": {}
  },
  "balconies": {
    "defaultEnclosureMode": "source-structure",
    "allowedModes": ["source-structure", "open-railing", "closed-glazing"],
    "overrides": {}
  },
  "structureEditing": {
    "wallEndpointEditing": true,
    "patchSchema": "interior.structure-edit-patch.v1"
  },
  "collision": {
    "mode": "swept-stop-at-first-contact",
    "stepMeters": 0.02
  }
}
