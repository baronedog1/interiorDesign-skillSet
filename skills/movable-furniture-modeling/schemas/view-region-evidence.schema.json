{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interior.local/schemas/product-view-region-evidence-v1.json",
  "title": "Product view region evidence v1",
  "type": "object",
  "required": ["schema", "viewId", "viewType", "source", "registration", "productMask", "components", "canonicalSha256"],
  "properties": {
    "schema": {"const": "interior.product-view-region-evidence.v1"},
    "viewId": {"type": "string", "minLength": 1},
    "viewType": {"enum": ["orthographic", "perspective"]},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "width", "height"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "registration": {
      "type": "object",
      "required": ["uAxis", "vAxis", "rayAxis", "uPixelRange", "vPixelRange", "uWorldRange", "vWorldRange"],
      "properties": {
        "uAxis": {"enum": ["x", "y", "z"]},
        "vAxis": {"enum": ["x", "y", "z"]},
        "rayAxis": {"enum": ["x", "y", "z"]},
        "uPixelRange": {"$ref": "#/$defs/range"},
        "vPixelRange": {"$ref": "#/$defs/range"},
        "uWorldRange": {"$ref": "#/$defs/range"},
        "vWorldRange": {"$ref": "#/$defs/range"},
        "rayDirection": {"enum": [-1, 1]}
      },
      "additionalProperties": false
    },
    "productMask": {"$ref": "#/$defs/mask"},
    "backgroundExclusionMask": {"$ref": "#/$defs/mask"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["componentId", "label", "visibleMask", "depthOrder"],
        "properties": {
          "componentId": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "visibleMask": {"$ref": "#/$defs/mask"},
          "carvingMask": {"$ref": "#/$defs/mask"},
          "depthOrder": {"type": "integer"},
          "projectionRequired": {"type": "boolean"},
          "occlusion": {"enum": ["none", "frontmost", "partially-occluded", "inferred-hidden"]}
        },
        "additionalProperties": true
      }
    },
    "quality": {"type": "object"},
    "canonicalSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "mask": {
      "type": "object",
      "required": ["encoding", "width", "height", "runs", "pixelCount", "sha256"],
      "properties": {
        "encoding": {"const": "row-rle-v1"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "runs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 0},
              {"type": "integer", "minimum": 0},
              {"type": "integer", "minimum": 1}
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "pixelCount": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
