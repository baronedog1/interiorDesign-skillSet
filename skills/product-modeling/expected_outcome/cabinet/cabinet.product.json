{
  "format": "product-modeling",
  "schemaVersion": 1,
  "id": "cabinet-32-system",
  "name": "32mm系统示例柜",
  "revision": "1.0.1",
  "mode": "parametric",
  "overview": "从柜体、底架、后加面板与可选迎面组件组合的结构示例。尺寸来自用户资料及明确标记的构造推定，不是加工图纸。",
  "source": {
    "reference": "用户附件《板式家具结构设计》11页",
    "status": "reference-plus-declared-assumptions",
    "notes": [
      "第6页：旁板654×394×18mm；底架80mm；面板25mm。",
      "第8页顶底板宽764mm；第10页文字说搁板短1mm但图标765mm。此示例采用763mm，仅为明确的推定。",
      "门板、抽屉、拉手及背板装配位置为示意，未按实物五金生产验证。"
    ]
  },
  "parameters": {
    "width": {
      "label": "柜体宽度",
      "type": "number",
      "unit": "mm",
      "min": 600,
      "max": 1200,
      "step": 10,
      "default": 800,
      "effect": "结构重算；板厚保持不变"
    },
    "side_height": {
      "label": "旁板高度",
      "type": "number",
      "unit": "mm",
      "min": 398,
      "max": 1294,
      "step": 32,
      "default": 654,
      "effect": "结构重算；默认654来自资料示例"
    },
    "depth": {
      "label": "柜体深度",
      "type": "number",
      "unit": "mm",
      "min": 330,
      "max": 650,
      "step": 1,
      "default": 394,
      "effect": "结构重算；不把外形强制为32倍数"
    },
    "thickness": {
      "label": "主体板厚",
      "type": "number",
      "unit": "mm",
      "min": 16,
      "max": 25,
      "step": 1,
      "default": 18,
      "effect": "显式改变板厚；内净宽随之重算"
    },
    "base_height": {
      "label": "底架高度",
      "type": "number",
      "unit": "mm",
      "min": 60,
      "max": 160,
      "step": 1,
      "default": 80,
      "effect": "底架构件与柜体高度联动"
    },
    "variant": {
      "label": "款式",
      "type": "enum",
      "default": "doors",
      "options": [
        {
          "value": "doors",
          "label": "双门柜"
        },
        {
          "value": "open",
          "label": "开架柜"
        },
        {
          "value": "drawers",
          "label": "双抽屉柜"
        }
      ],
      "effect": "替换迎面组件，保留柜体"
    },
    "finish": {
      "label": "饰面颜色",
      "type": "color",
      "default": "#bda684",
      "effect": "只改变饰面外观，不改变材料性能"
    },
    "roughness": {
      "label": "表面粗糙度",
      "type": "number",
      "min": 0.12,
      "max": 0.95,
      "step": 0.01,
      "default": 0.48,
      "effect": "视觉参数，不作为涂层工艺测量值"
    }
  },
  "derived": [
    {
      "id": "inner",
      "expr": [
        "-",
        [
          "ref",
          "width"
        ],
        [
          "*",
          2,
          [
            "ref",
            "thickness"
          ]
        ]
      ]
    },
    {
      "id": "body_center",
      "expr": [
        "+",
        [
          "ref",
          "base_height"
        ],
        [
          "/",
          [
            "ref",
            "side_height"
          ],
          2
        ]
      ]
    },
    {
