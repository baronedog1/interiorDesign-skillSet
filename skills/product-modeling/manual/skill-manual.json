  "logicDetails": [
    {
      "id": "fitting",
      "code": "D1",
      "title": "把看得见的特点，变成可检查的形体",
      "activation": "实际制作或修改形体，需要理解校准计算时",
      "explanation": "展开主图的形体校准节点，完成后回到材质阶段。",
      "returnTo": "surface",
      "diagrams": [
        {
          "title": "把看得见的特点，变成可检查的形体",
          "startNode": "observe",
          "endNodes": [
            "resume"
          ],
          "nodes": [
            {
              "id": "observe",
              "title": "找出这款产品靠什么被认出",
              "type": "process",
              "files": [
                {
                  "path": "playbook/geometry.md",
                  "purpose": "从款式特征、留空、截面及接头选择真实几何表示",
                  "role": "方法"
                }
              ],
              "lines": [
                "部件与空隙、粗细、弧面、端头和连接分别记录。"
              ]
            },
            {
              "id": "bind",
              "title": "把原图结构点绑定真实几何",
              "type": "process",
              "files": [
                {
                  "path": "data_contract.md",
                  "purpose": "规定生成器、真实锚点、单位、编辑与保存对象",
                  "role": "数据"
                },
                {
                  "path": "playbook/calibration.md",
                  "purpose": "区分点、轮廓与结构约束以及已执行与未测的误差",
                  "role": "方法"
                }
              ],
              "lines": [
                "标注来自读图；自动的是投影计算，不是语义判断。"
              ]
            },
            {
              "id": "solve",
              "title": "调整同一相机与有界形体参数",
              "type": "process",
              "files": [
                {
                  "path": "scripts/core.mjs",
                  "purpose": "计算透视相机、锚点投影、轮廓误差与有界求解",
                  "role": "模块"
                },
                {
                  "path": "scripts/feature-report.mjs",
                  "purpose": "测量关键特征的点、间距、曲线及留出偏差",
                  "role": "模块"
                }
              ],
              "lines": [
                "点误差按图像对角线归一，再加权求和。",
                "轮廓与结构项由任务脚本明确接入，未测不填零。"
              ]
            },
            {
              "id": "inspect",
              "title": "同机位核对整体和局部",
              "type": "process",
              "files": [
                {
                  "path": "playbook/calibration.md",
                  "purpose": "区分点、轮廓与结构约束以及已执行与未测的误差",
                  "role": "方法"
                }
              ],
              "lines": [
                "1000×1000图上10像素点误差，归一约0.00707。",
                "权重1的该点损失约0.00005；20像素留出点只报告。",
                "轮廓未标注就写未测，不能当完全吻合。"
              ]
            },
            {
              "id": "resume",
              "title": "记录偏差后回到材质阶段",
              "type": "io",
              "files": [
                {
                  "path": "expected_outcome/expected_outcome.md",
                  "purpose": "区分形体对应、浏览器运行及未完成事项",
                  "role": "方法"
                }
              ],
              "lines": [
                "关键特征错位要修几何，整体重合分数不能抵消。"
              ]
            }
          ],
          "edges": [
            {
              "from": "observe",
              "to": "bind"
            },
            {
              "from": "bind",
              "to": "solve"
            },
            {
              "from": "solve",
              "to": "inspect"
            },
            {
              "from": "inspect",
              "to": "resume"
            }
          ],
          "layout": {
            "kind": "semantic-grid",
            "reason": "单一展开阶段按因果顺序排列，不保留空列。",
            "rows": [
              [
                "observe"
              ],
              [
                "bind"
              ],
              [
                "solve"
              ],
              [
                "inspect"
              ],
              [
                "resume"
              ]
            ],
            "columnWidths": [
              620
            ]
          }
        }
      ]
    },
