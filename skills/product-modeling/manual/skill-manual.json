              "lines": [
                "咨询、发送、确定数据编译或只截图，按本次要求处理。",
                "只有改技能代码或规则时进入改版详情。"
              ],
              "detailRef": "maintenance"
            },
            {
              "id": "geometry",
              "title": "按原图校准形体和连接",
              "type": "process",
              "files": [
                {
                  "path": "playbook/geometry.md",
                  "purpose": "从款式特征、留空、截面及接头选择真实几何表示",
