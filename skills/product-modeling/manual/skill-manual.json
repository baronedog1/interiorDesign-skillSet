              "lines": [
                "先骨架与机位，再局部排列、截面和接头。",
                "背面可合理推测，可见处同机位核对。"
              ],
              "detailRef": "fitting"
            },
            {
              "id": "surface",
              "title": "按部件贴合材质颜色和光影",
