                  "path": "SKILL.md",
                  "purpose": "识别单品建模请求、路由及最终交付范围",
                  "role": "入口"
                },
                {
                  "path": "local_runtime.md",
                  "purpose": "任务依赖安装、构建命令与设备同步方法",
