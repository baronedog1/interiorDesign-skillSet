{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interior.local/schemas/product-multi-view-carving-plan-v1.json",
  "title": "Product multi-view carving plan v1",
  "type": "object",
  "required": ["schema", "planId", "primaryViewId", "evidence", "axisFallbacks", "components"],
  "properties": {
    "schema": {"const": "interior.product-multi-view-carving-plan.v1"},
    "planId": {"type": "string", "minLength": 1},
    "primaryViewId": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["viewId", "path"],
        "properties": {
          "viewId": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "useForCarving": {"type": "boolean"},
          "useForProjectionGate": {"type": "boolean"},
          "fallbackToProductMask": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "axisFallbacks": {
      "type": "object",
      "properties": {
        "x": {"$ref": "#/$defs/fallback"},
        "y": {"$ref": "#/$defs/fallback"},
        "z": {"$ref": "#/$defs/fallback"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["componentId", "label", "material", "inferenceFlags"],
        "properties": {
          "componentId": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "material": {"type": "object"},
          "axisBounds": {"type": "object"},
          "inferenceFlags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "fallback": {
      "type": "object",
      "required": ["min", "max", "cells", "source"],
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "cells": {"type": "integer", "minimum": 1},
        "source": {"enum": ["measured", "ratio-estimate", "single-view-inferred"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
