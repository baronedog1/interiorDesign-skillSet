{
  "schema": "interior.closed-world-view-policy.v1",
  "policyVersion": "1.0",
  "semantics": "Every current-shot room, connection, structure and placement slot is enumerated. Anything not enumerated is absent from the view.",
  "allowedAdditionClasses": [
    "decorative-object",
    "wall-art",
    "luminaire",
    "ceiling-nonstructural-detail",
    "soft-furnishing-accessory"
  ],
  "forbiddenInferenceClasses": [
    "unlisted-room",
    "unlisted-interior-space",
    "unlisted-structure",
    "unlisted-door",
    "unlisted-window",
    "unlisted-open-passage",
    "unlisted-placement-slot",
    "unlisted-movable-furniture",
    "unlisted-fixed-cabinet",
    "unlisted-appliance-or-fixture",
    "interior-room-beyond-exterior-boundary"
  ],
  "exteriorBoundaryRules": {
    "door": {
      "allowedDepictions": [
        "closed-existing-door-leaf",
        "open-existing-door-to-exterior"
      ],
      "forbiddenDepictions": [
        "interior-room-continuation",
        "invented-interior-doorway",
        "invented-room-behind-boundary"
      ]
    },
    "open-passage": {
      "allowedDepictions": [
        "open-to-exterior"
      ],
      "forbiddenDepictions": [
        "interior-room-continuation",
        "invented-interior-doorway",
        "invented-room-behind-boundary"
      ]
    },
    "default": {
      "allowedDepictions": [
        "preserve-existing-exterior-boundary"
      ],
      "forbiddenDepictions": [
        "interior-room-continuation",
        "invented-interior-doorway",
        "invented-room-behind-boundary"
      ]
    }
  }
}
