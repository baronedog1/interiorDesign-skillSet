{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interior.cad-object-view-evidence.v1",
  "title": "CAD Object View Region Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "objectId", "sourceInventory", "views", "overallPassed", "evidenceHash"],
  "properties": {
    "schema": {"const": "interior.cad-object-view-evidence.v1"},
    "objectId": {"type": "string", "minLength": 1},
    "sourceInventory": {"$ref": "#/$defs/binding"},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewId", "sourceId", "sourceSha256", "sourceSize", "foregroundMask", "components", "unionMask", "gates", "passed"],
        "properties": {
          "viewId": {"type": "string", "minLength": 1},
          "sourceId": {"type": "string", "minLength": 1},
          "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sourceSize": {"$ref": "#/$defs/size"},
          "foregroundMask": {"$ref": "#/$defs/artifact"},
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["componentId", "boundaryRings", "holeRings", "mask", "pixelCount", "bbox"],
              "properties": {
                "componentId": {"type": "string", "minLength": 1},
                "boundaryRings": {"$ref": "#/$defs/rings"},
                "holeRings": {"$ref": "#/$defs/rings"},
                "mask": {"$ref": "#/$defs/artifact"},
                "pixelCount": {"type": "integer", "minimum": 1},
                "bbox": {"$ref": "#/$defs/bbox"}
              }
            }
          },
          "unionMask": {"$ref": "#/$defs/artifact"},
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["missingPixels", "extraPixels", "overlapPixels", "maxMissingPixels", "maxExtraPixels", "maxOverlapPixels", "toleranceRationale"],
            "properties": {
              "missingPixels": {"type": "integer", "minimum": 0},
              "extraPixels": {"type": "integer", "minimum": 0},
              "overlapPixels": {"type": "integer", "minimum": 0},
              "maxMissingPixels": {"type": "integer", "minimum": 0},
              "maxExtraPixels": {"type": "integer", "minimum": 0},
              "maxOverlapPixels": {"type": "integer", "minimum": 0},
              "toleranceRationale": {"type": "string"}
            }
          },
          "passed": {"type": "boolean"}
        }
      }
    },
    "overallPassed": {"type": "boolean"},
    "evidenceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rings": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "items": {"$ref": "#/$defs/point"}
      }
    }
  }
}
