{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interior.cad-object-package.v1",
  "title": "CAD Object Delivery Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "objectId", "status", "inputGrade", "projectRoot", "sourceInventory", "viewEvidence", "plan", "generator", "step", "secondaryArtifacts", "validation", "timing", "unresolvedAssumptions", "limitations", "packageHash"],
  "properties": {
    "schema": {"const": "interior.cad-object-package.v1"},
    "objectId": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "provisional"]},
    "inputGrade": {"enum": ["A", "B", "C"]},
    "projectRoot": {"type": "string", "minLength": 1},
    "sourceInventory": {"$ref": "#/$defs/artifact"},
    "viewEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "plan": {"$ref": "#/$defs/artifact"},
    "generator": {"$ref": "#/$defs/artifact"},
    "step": {"$ref": "#/$defs/artifact"},
    "secondaryArtifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "validation": {"$ref": "#/$defs/artifact"},
    "timing": {"$ref": "#/$defs/artifact"},
    "unresolvedAssumptions": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "packageHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
